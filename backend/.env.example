# --- Optional: free local model to polish issue titles ------------------
# Install Ollama (https://ollama.com, free, runs on your machine), then:
#   ollama pull qwen2.5:3b
# Snappsense detects it automatically. Leave unset to use built-in titles only.
# SNAPPSENSE_LOCAL_MODEL=qwen2.5:3b
# OLLAMA_URL=http://127.0.0.1:11434

# --- App Store Connect (optional, for apps your team owns) ----------------
# Reads the complete review history instead of Apple's public featured reviews.
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY_ID=XXXXXXXXXX
# ASC_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# --- Tuning ----------------------------------------------------------------
# SNAPPSENSE_CACHE_TTL=21600    # seconds a report stays fresh (6 h)
# SNAPPSENSE_MAX_JOBS=4         # analyses running at once
# SNAPPSENSE_FETCH_WORKERS=24   # threads for parallel Play Store paging
# SNAPPSENSE_CORS=http://localhost:5179
